   {"kind": "generalization", "from": "Admin", "to": "Librarian"},
   {"kind": "association", "from": "Guest", "to": "Search catalog"},
   {"kind": "association", "from": "Member", "to": "Borrow book"},
   {"kind": "association", "from": "Member", "to": "Return book"},
   {"kind": "association", "from": "Member", "to": "Reserve book"},
   {"kind": "association", "from": "Member", "to": "Renew loan"},
   {"kind": "association", "from": "Librarian", "to": "Return book"},
   {"kind": "association", "from": "Librarian", "to": "Manage catalog"},
   {"kind": "association", "from": "Admin", "to": "Manage members"},
   {"kind": "dependency", "from": "Borrow book", "to": "Log in", "stereotype": "include"},
   {"kind": "dependency", "from": "Reserve book", "to": "Log in", "stereotype": "include"},
   {"kind": "dependency", "from": "Renew loan", "to": "Log in", "stereotype": "include"},
   {"kind": "dependency", "from": "Pay fine", "to": "Return book", "stereotype": "extend"}
  ]
 },
 "services": {
  "tool": "draw_component_diagram",
  "elements": [
   {"kind": "component", "name": "Web App"},
   {"kind": "component", "name": "Mobile App"},
   {"kind": "component", "name": "API Gateway"},
   {"kind": "lollipop", "name": "PublicApi"},
   {"kind": "package", "name": "backend"},
   {"kind": "component", "name": "Order Service", "in": "backend"},
   {"kind": "lollipop", "name": "OrderApi", "in": "backend"},
   {"kind": "component", "name": "Payment Service", "in": "backend"},
   {"kind": "lollipop", "name": "PaymentApi", "in": "backend"},
