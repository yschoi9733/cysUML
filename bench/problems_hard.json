   {"kind": "actor", "name": "Member"},
   {"kind": "actor", "name": "Librarian"},
   {"kind": "actor", "name": "Admin"},
   {"kind": "system", "name": "Library System"},
   {"kind": "use_case", "name": "Search catalog", "in": "Library System"},
   {"kind": "use_case", "name": "Log in", "in": "Library System"},
   {"kind": "use_case", "name": "Borrow book", "in": "Library System"},
   {"kind": "use_case", "name": "Return book", "in": "Library System"},
   {"kind": "use_case", "name": "Reserve book", "in": "Library System"},
   {"kind": "use_case", "name": "Renew loan", "in": "Library System"},
   {"kind": "use_case", "name": "Pay fine", "in": "Library System"},
   {"kind": "use_case", "name": "Manage catalog", "in": "Library System"},
   {"kind": "use_case", "name": "Manage members", "in": "Library System"}
