{
 "store-xl": {
  "tool": "draw_class_diagram",
  "classes": [
   {"name": "User", "kind": "abstract", "attributes": ["-id: long", "-email: String"]},
   {"name": "Customer", "attributes": ["-points: int"]},
   {"name": "Seller", "attributes": ["-rating: double"]},
   {"name": "Admin"},
   {"name": "Address", "attributes": ["-city: String", "-zip: String"]},
   {"name": "Store", "attributes": ["-name: String"]},
   {"name": "Product", "kind": "abstract", "attributes": ["-name: String", "-price: Money"]},
   {"name": "PhysicalProduct", "attributes": ["-weight: double"]},
   {"name": "DigitalProduct", "attributes": ["-url: String"]},
   {"name": "Category", "attributes": ["-name: String"]},
   {"name": "Review", "attributes": ["-stars: int"]},
   {"name": "Cart"},
   {"name": "CartItem", "attributes": ["-quantity: int"]},
   {"name": "Order", "attributes": ["-placedAt: DateTime"], "operations": ["+total(): Money"]},
   {"name": "OrderLine", "attributes": ["-quantity: int"]},
   {"name": "Shipment", "attributes": ["-trackingNo: String"]},
   {"name": "Coupon", "attributes": ["-code: String"]},
   {"name": "Payment", "kind": "interface", "operations": ["+pay(amount: Money): Receipt"]},
   {"name": "CardPayment"},
   {"name": "PointPayment"},
   {"name": "OrderStatus", "kind": "enum", "literals": ["PLACED", "PAID", "SHIPPED", "CANCELLED"]},
   {"name": "Inventory", "attributes": ["-stock: int"]}
  ],
  "relations": [
   {"kind": "generalization", "from": "Customer", "to": "User"},
   {"kind": "generalization", "from": "Seller", "to": "User"},
   {"kind": "generalization", "from": "Admin", "to": "User"},
   {"kind": "generalization", "from": "PhysicalProduct", "to": "Product"},
   {"kind": "generalization", "from": "DigitalProduct", "to": "Product"},
   {"kind": "realization", "from": "CardPayment", "to": "Payment"},
   {"kind": "realization", "from": "PointPayment", "to": "Payment"},
   {"kind": "association", "from": "Seller", "to": "Store", "name": "owns", "from_multiplicity": "1", "to_multiplicity": "1..*"},
   {"kind": "aggregation", "from": "Store", "to": "Product", "to_multiplicity": "*"},
   {"kind": "composition", "from": "Store", "to": "Inventory", "to_multiplicity": "1"},
   {"kind": "association", "from": "Inventory", "to": "PhysicalProduct", "name": "tracks", "to_multiplicity": "*"},
   {"kind": "association", "from": "Product", "to": "Category", "from_multiplicity": "*", "to_multiplicity": "1"},
   {"kind": "association", "from": "Customer", "to": "Review", "name": "writes", "from_multiplicity": "1", "to_multiplicity": "*"},
   {"kind": "association", "from": "Review", "to": "Product", "from_multiplicity": "*", "to_multiplicity": "1"},
   {"kind": "association", "from": "Customer", "to": "Order", "name": "places", "from_multiplicity": "1", "to_multiplicity": "*"},
   {"kind": "composition", "from": "Order", "to": "OrderLine", "to_multiplicity": "1..*"},
   {"kind": "association", "from": "OrderLine", "to": "Product", "to_multiplicity": "1"},
   {"kind": "composition", "from": "Customer", "to": "Cart", "to_multiplicity": "1"},
   {"kind": "composition", "from": "Cart", "to": "CartItem", "to_multiplicity": "*"},
   {"kind": "association", "from": "CartItem", "to": "Product", "to_multiplicity": "1"},
   {"kind": "aggregation", "from": "Customer", "to": "Address", "to_multiplicity": "0..*"},
   {"kind": "association", "from": "Order", "to": "Shipment", "to_multiplicity": "0..1"},
   {"kind": "association", "from": "Shipment", "to": "Address", "name": "ships to", "to_multiplicity": "1"},
   {"kind": "association", "from": "Order", "to": "Coupon", "to_multiplicity": "0..1"},
   {"kind": "association", "from": "Order", "to": "Payment", "name": "paid by", "to_multiplicity": "1"},
   {"kind": "dependency", "from": "Order", "to": "OrderStatus"}
  ]
 },
 "modules-xl": {
  "tool": "draw_package_diagram",
  "elements": [
   {"kind": "package", "name": "shop"},
   {"kind": "package", "name": "api", "in": "shop"},
   {"kind": "class", "name": "OrderController", "in": "api"},
   {"kind": "class", "name": "ProductController", "in": "api"},
   {"kind": "class", "name": "AuthFilter", "in": "api"},
   {"kind": "package", "name": "core", "in": "shop"},
   {"kind": "interface", "name": "Mailer", "in": "core"},
   {"kind": "package", "name": "order", "in": "core"},
   {"kind": "class", "name": "Order", "in": "order"},
   {"kind": "interface", "name": "OrderService", "in": "order"},
   {"kind": "class", "name": "OrderServiceImpl", "in": "order"},
   {"kind": "interface", "name": "OrderRepository", "in": "order"},
   {"kind": "package", "name": "catalog", "in": "core"},
   {"kind": "class", "name": "Product", "in": "catalog"},
   {"kind": "interface", "name": "ProductService", "in": "catalog"},
   {"kind": "class", "name": "ProductServiceImpl", "in": "catalog"},
   {"kind": "interface", "name": "ProductRepository", "in": "catalog"},
   {"kind": "package", "name": "infra", "in": "shop"},
   {"kind": "package", "name": "jpa", "in": "infra"},
   {"kind": "class", "name": "JpaOrderRepository", "in": "jpa"},
   {"kind": "class", "name": "JpaProductRepository", "in": "jpa"},
   {"kind": "package", "name": "mail", "in": "infra"},
   {"kind": "class", "name": "SmtpMailer", "in": "mail"}
  ],
  "relations": [
   {"kind": "dependency", "from": "api", "to": "core", "stereotype": "use"},
   {"kind": "dependency", "from": "infra", "to": "core", "stereotype": "use"},
   {"kind": "realization", "from": "OrderServiceImpl", "to": "OrderService"},
   {"kind": "realization", "from": "ProductServiceImpl", "to": "ProductService"},
   {"kind": "realization", "from": "JpaOrderRepository", "to": "OrderRepository"},
   {"kind": "realization", "from": "JpaProductRepository", "to": "ProductRepository"},
   {"kind": "realization", "from": "SmtpMailer", "to": "Mailer"},
   {"kind": "dependency", "from": "OrderController", "to": "OrderService"},
   {"kind": "dependency", "from": "ProductController", "to": "ProductService"},
   {"kind": "dependency", "from": "OrderServiceImpl", "to": "OrderRepository"},
   {"kind": "dependency", "from": "OrderServiceImpl", "to": "Mailer"},
   {"kind": "dependency", "from": "OrderServiceImpl", "to": "ProductService"},
   {"kind": "dependency", "from": "ProductServiceImpl", "to": "ProductRepository"},
   {"kind": "association", "from": "Order", "to": "Product", "name": "contains", "from_multiplicity": "*", "to_multiplicity": "1..*"}
  ]
 },
 "fulfillment-xl": {
  "tool": "draw_activity_diagram",
  "elements": [
   {"kind": "initial", "id": "start"},
   {"kind": "action", "name": "Receive order"},
   {"kind": "action", "name": "Check stock"},
   {"kind": "decision", "id": "in stock?"},
   {"kind": "action", "name": "Request restock"},
   {"kind": "action", "name": "Wait for supplier"},
   {"kind": "decision", "id": "arrived?"},
   {"kind": "merge", "id": "stock ready"},
   {"kind": "action", "name": "Pick items"},
   {"kind": "action", "name": "Pack box"},
   {"kind": "action", "name": "Inspect package"},
   {"kind": "decision", "id": "ok?"},
   {"kind": "action", "name": "Print label"},
   {"kind": "action", "name": "Ship"},
   {"kind": "decision", "id": "delivered?"},
   {"kind": "decision", "id": "attempts left?"},
   {"kind": "action", "name": "Return to warehouse"},
   {"kind": "action", "name": "Confirm delivery"},
   {"kind": "merge", "id": "closed"},
   {"kind": "final", "id": "end"}
  ],
  "relations": [
   {"from": "start", "to": "Receive order"},
   {"from": "Receive order", "to": "Check stock"},
   {"from": "Check stock", "to": "in stock?"},
   {"from": "in stock?", "to": "stock ready", "name": "[yes]"},
   {"from": "in stock?", "to": "Request restock", "name": "[no]"},
   {"from": "Request restock", "to": "Wait for supplier"},
   {"from": "Wait for supplier", "to": "arrived?"},
   {"from": "arrived?", "to": "Wait for supplier", "name": "[no]"},
   {"from": "arrived?", "to": "stock ready", "name": "[yes]"},
   {"from": "stock ready", "to": "Pick items"},
   {"from": "Pick items", "to": "Pack box"},
   {"from": "Pack box", "to": "Inspect package"},
   {"from": "Inspect package", "to": "ok?"},
   {"from": "ok?", "to": "Pack box", "name": "[no]"},
   {"from": "ok?", "to": "Print label", "name": "[yes]"},
   {"from": "Print label", "to": "Ship"},
   {"from": "Ship", "to": "delivered?"},
   {"from": "delivered?", "to": "Confirm delivery", "name": "[yes]"},
   {"from": "delivered?", "to": "attempts left?", "name": "[no]"},
   {"from": "attempts left?", "to": "Ship", "name": "[yes]"},
   {"from": "attempts left?", "to": "Return to warehouse", "name": "[no]"},
   {"from": "Confirm delivery", "to": "closed"},
   {"from": "Return to warehouse", "to": "closed"},
   {"from": "closed", "to": "end"}
  ]
 },
 "subscription-xl": {
  "tool": "draw_state_diagram",
  "elements": [
   {"kind": "initial", "id": "start"},
   {"kind": "state", "name": "Trial"},
   {"kind": "choice", "id": "converted?"},
   {"kind": "state", "name": "Active"},
   {"kind": "initial", "id": "a-start", "in": "Active"},
   {"kind": "state", "name": "Paid", "in": "Active"},
   {"kind": "state", "name": "Renewing", "in": "Active", "actions": ["do / charge card"]},
   {"kind": "choice", "id": "charged?", "in": "Active"},
   {"kind": "state", "name": "Grace", "in": "Active", "actions": ["entry / send warning"]},
   {"kind": "state", "name": "Paused"},
   {"kind": "state", "name": "Closed"},
   {"kind": "state", "name": "Cancelled", "in": "Closed"},
   {"kind": "state", "name": "Expired", "in": "Closed"},
   {"kind": "final", "id": "end"}
  ],
  "relations": [
   {"from": "start", "to": "Trial"},
   {"from": "Trial", "to": "converted?", "name": "trial ends"},
   {"from": "converted?", "to": "Active", "name": "[yes]"},
   {"from": "converted?", "to": "Expired", "name": "[no]"},
   {"from": "a-start", "to": "Paid"},
   {"from": "Paid", "to": "Renewing", "name": "renewal due"},
   {"from": "Renewing", "to": "charged?"},
   {"from": "charged?", "to": "Paid", "name": "[ok]"},
   {"from": "charged?", "to": "Grace", "name": "[failed]"},
   {"from": "Grace", "to": "Renewing", "name": "retry"},
   {"from": "Grace", "to": "Expired", "name": "grace over"},
   {"from": "Active", "to": "Paused", "name": "pause"},
   {"from": "Paused", "to": "Active", "name": "resume"},
   {"from": "Active", "to": "Cancelled", "name": "cancel"},
   {"from": "Paused", "to": "Cancelled", "name": "cancel"},
   {"from": "Closed", "to": "end"}
  ]
 },
