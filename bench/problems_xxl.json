   {"name": "Section", "attributes": ["-number: int"]},
   {"name": "Semester", "attributes": ["-year: int", "-term: String"]},
   {"name": "Building", "attributes": ["-name: String"]},
   {"name": "Classroom", "attributes": ["-room: String"]},
   {"name": "Schedule", "attributes": ["-weekday: int", "-start: Time"]},
   {"name": "Enrollment", "attributes": ["-enrolledAt: Date"]},
   {"name": "Grade", "kind": "enum", "literals": ["A", "B", "C", "D", "F"]},
   {"name": "Assignment", "attributes": ["-due: DateTime"]},
   {"name": "Submission", "attributes": ["-submittedAt: DateTime"]},
