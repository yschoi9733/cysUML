   {"kind": "association", "from": "Assignment", "to": "Rubric", "to_multiplicity": "0..1"},
   {"kind": "composition", "from": "Section", "to": "Quiz", "to_multiplicity": "*"},
   {"kind": "composition", "from": "Quiz", "to": "Question", "to_multiplicity": "1..*"},
   {"kind": "association", "from": "Answer", "to": "Question", "from_multiplicity": "*", "to_multiplicity": "1"},
   {"kind": "association", "from": "Student", "to": "Answer", "from_multiplicity": "1", "to_multiplicity": "*"},
   {"kind": "association", "from": "Section", "to": "GradingPolicy", "to_multiplicity": "1"},
   {"kind": "composition", "from": "Section", "to": "Announcement", "to_multiplicity": "*"},
   {"kind": "dependency", "from": "Announcement", "to": "Notifier"},
   {"kind": "composition", "from": "Section", "to": "Forum", "to_multiplicity": "1"},
   {"kind": "composition", "from": "Forum", "to": "Thread", "to_multiplicity": "*"},
   {"kind": "composition", "from": "Thread", "to": "Post", "to_multiplicity": "1..*"},
   {"kind": "association", "from": "Post", "to": "User", "name": "author", "from_multiplicity": "*", "to_multiplicity": "1"},
   {"kind": "aggregation", "from": "Post", "to": "Attachment", "to_multiplicity": "*"},
   {"kind": "composition", "from": "Student", "to": "Transcript", "to_multiplicity": "1"},
   {"kind": "association", "from": "Transcript", "to": "Enrollment", "to_multiplicity": "*"},
   {"kind": "association", "from": "Certificate", "to": "Course", "from_multiplicity": "*", "to_multiplicity": "1"},
   {"kind": "association", "from": "Student", "to": "Certificate", "from_multiplicity": "1", "to_multiplicity": "*"}
  ]
 },
