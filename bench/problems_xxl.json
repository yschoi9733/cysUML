   {"from": "Disburse funds", "to": "notify"},
   {"from": "notify", "to": "Notify applicant"},
   {"from": "Notify applicant", "to": "Archive file"},
   {"from": "Archive file", "to": "done"},
   {"from": "Close application", "to": "done"},
   {"from": "done", "to": "end"}
  ]
 },
