   {"kind": "realization", "from": "PushNotifier", "to": "Notifier"},
   {"kind": "association", "from": "Admin", "to": "Department", "name": "manages", "from_multiplicity": "1", "to_multiplicity": "*"},
   {"kind": "composition", "from": "Department", "to": "Course", "to_multiplicity": "*"},
   {"kind": "composition", "from": "Course", "to": "Section", "to_multiplicity": "1..*"},
   {"kind": "association", "from": "Section", "to": "Semester", "from_multiplicity": "*", "to_multiplicity": "1"},
   {"kind": "association", "from": "Section", "to": "Instructor", "name": "taught by", "from_multiplicity": "*", "to_multiplicity": "1..*"},
   {"kind": "association", "from": "Section", "to": "Classroom", "name": "meets in", "from_multiplicity": "*", "to_multiplicity": "0..1"},
   {"kind": "composition", "from": "Building", "to": "Classroom", "to_multiplicity": "*"},
   {"kind": "composition", "from": "Section", "to": "Schedule", "to_multiplicity": "1"},
   {"kind": "association", "from": "Student", "to": "Enrollment", "from_multiplicity": "1", "to_multiplicity": "*"},
   {"kind": "association", "from": "Enrollment", "to": "Section", "from_multiplicity": "*", "to_multiplicity": "1"},
   {"kind": "dependency", "from": "Enrollment", "to": "Grade"},
   {"kind": "composition", "from": "Section", "to": "Assignment", "to_multiplicity": "*"},
   {"kind": "association", "from": "Submission", "to": "Assignment", "from_multiplicity": "*", "to_multiplicity": "1"},
   {"kind": "association", "from": "Student", "to": "Submission", "name": "submits", "from_multiplicity": "1", "to_multiplicity": "*"},
