   {"name": "MultipleChoice"},
   {"name": "ShortAnswer"},
   {"name": "Answer"},
   {"name": "GradingPolicy", "kind": "interface", "operations": ["+grade(e: Enrollment): Grade"]},
   {"name": "WeightedPolicy"},
   {"name": "PassFailPolicy"},
   {"name": "Announcement", "attributes": ["-title: String"]},
   {"name": "Notifier", "kind": "interface", "operations": ["+send(msg: String): void"]},
   {"name": "EmailNotifier"},
   {"name": "PushNotifier"},
   {"name": "Forum"},
   {"name": "Thread", "attributes": ["-title: String"]},
   {"name": "Post", "attributes": ["-body: String"]},
   {"name": "Transcript"},
   {"name": "Certificate", "attributes": ["-issuedAt: Date"]}
  ],
  "relations": [
   {"kind": "generalization", "from": "Student", "to": "User"},
   {"kind": "generalization", "from": "Instructor", "to": "User"},
   {"kind": "generalization", "from": "Admin", "to": "User"},
   {"kind": "generalization", "from": "TeachingAssistant", "to": "Student"},
   {"kind": "generalization", "from": "MultipleChoice", "to": "Question"},
   {"kind": "generalization", "from": "ShortAnswer", "to": "Question"},
