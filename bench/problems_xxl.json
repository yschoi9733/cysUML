   {"from": "officer ok?", "to": "rejected", "name": "[no]"},
   {"from": "rejected", "to": "Reject"},
   {"from": "approved", "to": "Calculate offer"},
   {"from": "Calculate offer", "to": "Send offer"},
   {"from": "Send offer", "to": "Wait for acceptance"},
   {"from": "Wait for acceptance", "to": "accepted?"},
   {"from": "accepted?", "to": "Sign contract", "name": "[yes]"},
   {"from": "accepted?", "to": "negotiate?", "name": "[no]"},
