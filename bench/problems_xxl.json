   {"from": "Adjust terms", "to": "Send offer"},
   {"from": "negotiate?", "to": "Withdraw offer", "name": "[no]"},
   {"from": "Sign contract", "to": "Disburse funds"},
   {"from": "Reject", "to": "notify"},
